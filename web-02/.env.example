# Copy to .env before starting. Keep this file private.
WEB02_PORT=8080
WEB02_SECRET_KEY=replace-with-a-long-random-secret
WEB02_COOKIE_SECURE=false
WEB02_ENV=development

# Choose the same provider and keys configured for DA-Agent-drive.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
E2B_API_KEY=

# Bootstrap the first teacher with: docker compose run --rm api python -m app.bootstrap
BOOTSTRAP_TEACHER_EMAIL=teacher@example.edu
BOOTSTRAP_TEACHER_NAME=Giáo viên
BOOTSTRAP_TEACHER_PASSWORD=
